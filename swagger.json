{
  "openapi": "3.0.3",
  "info": {
    "title": "ACME HR Salary Management API",
    "version": "1.0.0",
    "description": "Backend APIs for employee salary management, dashboard, and analytics."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "tags": [
    {
      "name": "Employees"
    },
    {
      "name": "Salary"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Analytics"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "tags": ["Employees"],
        "summary": "Get employees",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "designation",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["ACTIVE", "INACTIVE"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee list"
          }
        }
      },
      "post": {
        "tags": ["Employees"],
        "summary": "Create employee",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created"
          },
          "409": {
            "description": "Duplicate email"
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "tags": ["Employees"],
        "summary": "Get employee details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee details"
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "put": {
        "tags": ["Employees"],
        "summary": "Update employee",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated"
          }
        }
      }
    },
    "/employees/{id}/salary": {
      "post": {
        "tags": ["Salary"],
        "summary": "Create salary revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalaryRevisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Salary revision created"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Dashboard summary",
        "responses": {
          "200": {
            "description": "Dashboard metrics"
          }
        }
      }
    },
    "/dashboard/recent-salary-revisions": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Recent salary revisions",
        "responses": {
          "200": {
            "description": "Recent salary activity"
          }
        }
      }
    },
    "/analytics/summary": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Analytics summary",
        "responses": {
          "200": {
            "description": "Analytics overview"
          }
        }
      }
    },
    "/analytics/by-department": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Department analytics",
        "responses": {
          "200": {
            "description": "Department breakdown"
          }
        }
      }
    },
    "/analytics/by-country": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Country analytics",
        "responses": {
          "200": {
            "description": "Country breakdown"
          }
        }
      }
    },
    "/analytics/by-designation": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Designation analytics",
        "responses": {
          "200": {
            "description": "Designation breakdown"
          }
        }
      }
    },
    "/analytics/salary-distribution": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Salary distribution",
        "responses": {
          "200": {
            "description": "Salary bands"
          }
        }
      }
    },
    "/analytics/hiring-trends": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Hiring trends",
        "responses": {
          "200": {
            "description": "Hiring trend data"
          }
        }
      }
    },
    "/analytics/payroll-trends": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Payroll trends",
        "responses": {
          "200": {
            "description": "Payroll trend data"
          }
        }
      }
    },
    "/analytics/top-earners": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Top earners",
        "responses": {
          "200": {
            "description": "Highest paid employees"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "departmentId",
          "countryId",
          "designation",
          "joinDate",
          "initialSalary"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "designation": {
            "type": "string"
          },
          "joinDate": {
            "type": "string",
            "format": "date"
          },
          "initialSalary": {
            "$ref": "#/components/schemas/SalaryInput"
          }
        }
      },
      "UpdateEmployeeRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "designation": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE"]
          }
        }
      },
      "CreateSalaryRevisionRequest": {
        "type": "object",
        "required": [
          "effectiveDate",
          "baseSalary"
        ],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SalaryInput": {
        "type": "object",
        "required": [
          "effectiveDate",
          "baseSalary"
        ],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}