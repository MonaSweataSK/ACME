{
  "openapi": "3.0.3",
  "info": {
    "title": "ACME Salary Management API",
    "version": "1.0.0",
    "description": "REST API for managing employees, salaries, and analytics for ACME. All currency conversion to USD is performed server‑side using the static `usd_multiplier` column in the `countries` table."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/departments": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Departments",
        "responses": {
          "200": {
            "description": "List of departments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentList"
                }
              }
            }
          }
        }
      }
    },
    "/designations": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Designations",
        "responses": {
          "200": {
            "description": "List of designations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignationList"
                }
              }
            }
          }
        }
      }
    },
    "/countries": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Countries",
        "responses": {
          "200": {
            "description": "List of countries with USD multiplier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryList"
                }
              }
            }
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Unified analytics endpoint",
        "description": "Compiles and flattens all high‑level KPIs, multi‑dimensional breakdowns, statistical salary‑band frequencies, and recent salary‑revision logs into a single JSON payload. Server‑side conversion to USD uses the static `usd_multiplier` column for deterministic results.",
        "parameters": [
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by department UUID"
          },
          {
            "name": "countryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by country UUID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            },
            "description": "Filter by employee status"
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard and analytics data combined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/export": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Export analytics to CSV",
        "description": "Generates an on‑demand CSV file containing the currently filtered analytics view (same filter parameters as the `/analytics` endpoint).",
        "parameters": [
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by department UUID"
          },
          {
            "name": "countryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by country UUID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            },
            "description": "Filter by employee status"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/employees": {
      "get": {
        "tags": ["Employee"],
        "summary": "Get Employees",
        "parameters": [
          {"name": "page", "in": "query", "schema": {"type": "integer"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer"}},
          {"name": "search", "in": "query", "schema": {"type": "string"}},
          {"name": "departmentId", "in": "query", "schema": {"type": "string", "format": "uuid"}},
          {"name": "designationId", "in": "query", "schema": {"type": "string", "format": "uuid"}},
          {"name": "countryId", "in": "query", "schema": {"type": "string", "format": "uuid"}},
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["ACTIVE","INACTIVE"]}}
        ],
        "responses": {"200": {"description": "List of employees", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmployeeList"}}}}}
      },
      "post": {
        "tags": ["Employee"],
        "summary": "Create Employee",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmployeeCreateRequest"}}}},
        "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmployeeCreateResponse"}}}}}
      }
    },
    "/employees/{id}": {
      "get": {
        "tags": ["Employee"],
        "summary": "Get Employee Details",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {"200": {"description": "Employee detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Employee"}}}}}
      },
      "put": {
        "tags": ["Employee"],
        "summary": "Update Employee",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmployeeUpdateRequest"}}}},
        "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"type": "object", "properties": {"message": {"type": "string"}}}}}}}
      }
    },
    "/employees/{id}/salary": {
      "post": {
        "tags": ["Salary"],
        "summary": "Add Salary Revision",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SalaryRevisionRequest"}}}},
        "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SalaryRevisionResponse"}}}}}
      }
    }
    
  },
  "components": {
    "schemas": {
      "DepartmentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          }
        }
      },
      "Department": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DesignationList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Designation"
            }
          }
        }
      },
      "Designation": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CountryList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Country"
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "required": [
          "id",
          "name",
          "currencyCode",
          "usdMultiplier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "currencyCode": {
            "type": "string",
            "example": "INR"
          },
          "usdMultiplier": {
            "type": "number",
            "description": "Static exchange‑rate multiplier used to convert the country’s local currency to USD. Stored in the `countries` table for deterministic, zero‑dependency conversion."
          }
        }
      },
      "AnalyticsResponse": {
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "departmentDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DepartmentAnalytics"
            }
          },
          "countryDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryAnalytics"
            }
          },
          "designationDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DesignationAnalytics"
            }
          },
          "salaryBands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalaryBand"
            }
          },
          "recentRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentRevision"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "totalEmployees": {
            "type": "integer"
          },
          "activeEmployees": {
            "type": "integer"
          },
          "inactiveEmployees": {
            "type": "integer"
          },
          "totalPayrollUSD": {
            "type": "number",
            "format": "float"
          },
          "averageSalaryUSD": {
            "type": "number",
            "format": "float"
          },
          "medianSalaryUSD": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "DepartmentAnalytics": {
        "type": "object",
        "properties": {
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "headcount": {
            "type": "integer"
          },
          "minSalaryUsd": {
            "type": "number"
          },
          "maxSalaryUsd": {
            "type": "number"
          },
          "avgSalaryUsd": {
            "type": "number"
          },
          "totalPayrollUsd": {
            "type": "number"
          }
        }
      },
      "CountryAnalytics": {
        "type": "object",
        "properties": {
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "headcount": {
            "type": "integer"
          },
          "totalPayrollUsd": {
            "type": "number"
          }
        }
      },
      "DesignationAnalytics": {
        "type": "object",
        "properties": {
          "designationId": {
            "type": "string",
            "format": "uuid"
          },
          "headcount": {
            "type": "integer"
          },
          "avgSalaryUsd": {
            "type": "number"
          }
        }
      },
      "SalaryBand": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "example": "0-25k"
          },
          "employeeCount": {
            "type": "integer"
          }
        }
      },
      "SalaryRevision": {
        "type": "object",
        "properties": {
          "employeeId": {"type": "string", "format": "uuid"},
          "revisionDate": {"type": "string", "format": "date-time"},
          "baseSalaryUsd": {"type": "number"},
          "bonusUsd": {"type": "number"},
          "allowancesUsd": {"type": "number"},
          "totalCtcUsd": {"type": "number"}
        }
      },
      "RecentRevision": {
        "type": "object",
        "properties": {
          "employeeCode": {"type": "string"},
          "name": {"type": "string"},
          "effectiveDate": {"type": "string", "format": "date"},
          "totalCtcUSD": {"type": "number"},
          "reason": {"type": "string"}
        }
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "employeeCode": {"type": "string"},
          "firstName": {"type": "string"},
          "lastName": {"type": "string"},
          "email": {"type": "string"},
          "department": {"type": "string"},
          "designation": {"type": "string"},
          "country": {"type": "string"},
          "status": {"type": "string"},
          "currentSalary": {"type": "object"}
        }
      },
      "EmployeeList": {
        "type": "object",
        "properties": {
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/Employee"}}
        }
      },
      "EmployeeCreateRequest": {
        "type": "object",
        "properties": {
          "firstName": {"type": "string"},
          "lastName": {"type": "string"},
          "email": {"type": "string"},
          "departmentId": {"type": "string", "format": "uuid"},
          "designationId": {"type": "string", "format": "uuid"},
          "countryId": {"type": "string", "format": "uuid"},
          "joinDate": {"type": "string", "format": "date"},
          "initialSalary": {
            "type": "object",
            "properties": {
              "baseSalary": {"type": "number"},
              "bonus": {"type": "number"},
              "allowances": {"type": "number"},
              "effectiveDate": {"type": "string", "format": "date"},
              "reason": {"type": "string"}
            }
          }
        },
        "required": ["firstName", "lastName", "email", "departmentId", "designationId", "countryId", "joinDate", "initialSalary"]
      },
      "EmployeeCreateResponse": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "employeeCode": {"type": "string"}
        }
      },
      "EmployeeUpdateRequest": {
        "type": "object",
        "properties": {
          "firstName": {"type": "string"},
          "lastName": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "departmentId": {"type": "string", "format": "uuid"},
          "designationId": {"type": "string", "format": "uuid"},
          "countryId": {"type": "string", "format": "uuid"},
          "status": {"type": "string"}
        }
      },
      "SalaryRevisionRequest": {
        "type": "object",
        "properties": {
          "effectiveDate": {"type": "string", "format": "date"},
          "baseSalary": {"type": "number"},
          "bonus": {"type": "number"},
          "allowances": {"type": "number"},
          "reason": {"type": "string"}
        },
        "required": ["effectiveDate", "baseSalary", "bonus", "allowances", "reason"]
      },
      "SalaryRevisionResponse": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "totalCtc": {"type": "number"}
        }
      }
    }
  }
}