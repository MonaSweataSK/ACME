{
  "openapi": "3.0.3",
  "info": {
    "title": "ACME HR Salary Management API",
    "version": "1.0.0",
    "description": "Backend APIs for employee salary management, dashboard, and analytics."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "tags": [
    {
      "name": "Employees"
    },
    {
      "name": "Salary"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Master Data"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "tags": [
          "Employees"
        ],
        "summary": "Get employees",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number (Defaults to 1)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Records per page for client virtualization scopes (Defaults to 20)"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Multi-vector wild-card text search by employee code, name, email"
          },
          {
            "name": "departmentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by department UUID"
          },
          {
            "name": "designationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by designation UUID"
          },
          {
            "name": "countryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Filter by country UUID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            },
            "description": "ACTIVE / INACTIVE"
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "firstName",
                "joinDate",
                "totalCtc"
              ]
            },
            "description": "Sort by field"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Sort order"
          }
        ],
        "responses": {
          "200": {
            "description": "Employee list"
          }
        }
      },
      "post": {
        "tags": [
          "Employees"
        ],
        "summary": "Create Employee",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created"
          },
          "409": {
            "description": "Duplicate email"
          },
          "400": {
            "description": "Bad Request - Validation failed for employee profile or salary payload"
          },
          "422": {
            "description": "Unprocessable Entity - Creation failed entirely, transaction rolled back"
          }
        },
        "description": "Registers a new hire within the database, auto-generating a unique employeeCode. It initializes the employee record and their starting salary contract inside a single, atomic database transaction block. Failure Handling Requirement: The transactional execution window must fail entirely if either the employee profile or the initial salary payload fails Zod schema validations or instantiation. This must throw a clean 400 Bad Request or 422 Unprocessable Entity, ensuring no orphan corporate identities are left dangling."
      }
    },
    "/employees/{id}": {
      "get": {
        "tags": [
          "Employees"
        ],
        "summary": "Get Employee Details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee details"
          },
          "404": {
            "description": "Employee not found"
          }
        },
        "description": "Compiles a comprehensive employee master profile container matching the specified structural UUID path parameters alongside their complete historical pay scale timeline."
      },
      "put": {
        "tags": [
          "Employees"
        ],
        "summary": "Update Employee",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated"
          }
        },
        "description": "Modifies basic administrative corporate configuration background vectors. Financial adjustments are blocked to protect historical line data integrity."
      }
    },
    "/employees/{id}/salary": {
      "post": {
        "tags": [
          "Salary"
        ],
        "summary": "Add Salary Revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSalaryRevisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Salary revision created"
          }
        },
        "description": "Enforces historical compensation data log immutability via sequential execution blocks. It automatically processes total server-side calculations for Total CTC (Base + Bonus + Allowances) while handling transaction boundaries to safely shift active pointer tags."
      }
    },
    "/dashboard/overview": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Unified dashboard overview",
        "responses": {
          "200": {
            "description": "Dashboard and analytics data combined"
          }
        },
        "description": "Compiles and flattens all high-level summary KPIs, multi-dimension analytical breakdowns, statistical salary band frequencies, and recent salary revision logs into a singular JSON payload. This single-pass engine uses a localized lookup matrix window on the backend to avoid concurrent query bottlenecking over SQLite's thread footprint, converting regional metrics cleanly into standardized USD for tracking visibility."
      }
    },
    "/departments": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Departments",
        "responses": {
          "200": {
            "description": "Departments list"
          }
        }
      }
    },
    "/designations": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Designations",
        "responses": {
          "200": {
            "description": "Designations list"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Countries",
        "responses": {
          "200": {
            "description": "Countries list"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "departmentId",
          "designationId",
          "countryId",
          "joinDate",
          "initialSalary"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "designationId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "joinDate": {
            "type": "string",
            "format": "date"
          },
          "initialSalary": {
            "$ref": "#/components/schemas/SalaryInput"
          }
        }
      },
      "UpdateEmployeeRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "designationId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "CreateSalaryRevisionRequest": {
        "type": "object",
        "required": [
          "effectiveDate",
          "baseSalary"
        ],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SalaryInput": {
        "type": "object",
        "required": [
          "effectiveDate",
          "baseSalary"
        ],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}