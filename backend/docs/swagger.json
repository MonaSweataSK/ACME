{
  "openapi": "3.0.3",
  "info": {
    "title": "ACME Salary Management API",
    "version": "1.0.0",
    "description": "REST API for managing employees, salaries, and analytics for ACME. All currency conversion to USD is performed server-side using the static `usd_multiplier` column in the `countries` table."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/departments": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Departments",
        "responses": {
          "200": {
            "description": "List of departments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentList"
                }
              }
            }
          }
        }
      }
    },
    "/designations": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Designations",
        "responses": {
          "200": {
            "description": "List of designations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignationList"
                }
              }
            }
          }
        }
      }
    },
    "/countries": {
      "get": {
        "tags": [
          "Master Data"
        ],
        "summary": "Get Countries",
        "responses": {
          "200": {
            "description": "List of countries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryList"
                }
              }
            }
          }
        }
      }
    },
    "/employees": {
      "get": {
        "tags": [
          "Employee"
        ],
        "summary": "Get Employees",
        "description": "Returns a paginated, filterable, searchable list of employees. Defaults: page=1, limit=20.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Records per page (default: 20)",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Wildcard search across employee code, name, and email",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departmentId",
            "in": "query",
            "description": "Filter by department UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "designationId",
            "in": "query",
            "description": "Filter by designation UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "countryId",
            "in": "query",
            "description": "Filter by country UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by employment status",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Field to sort by",
            "schema": {
              "type": "string",
              "enum": [
                "firstName",
                "joinDate",
                "totalCtc"
              ]
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of employees",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Employee"
        ],
        "summary": "Create Employee",
        "description": "Registers a new employee and their initial salary record in a single atomic transaction. Fails entirely with 400/422 if either the employee or salary payload is invalid — no orphan records are created.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — transaction rolled back"
          },
          "422": {
            "description": "Unprocessable entity — transaction rolled back"
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "tags": [
          "Employee"
        ],
        "summary": "Get Employee Details",
        "description": "Returns the full employee profile including department, designation, country objects, and complete salary history.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee detail with salary history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "put": {
        "tags": [
          "Employee"
        ],
        "summary": "Update Employee",
        "description": "Updates non-financial employee fields. Salary changes are blocked here — use POST /employees/{id}/salary instead.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Employee updated successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      }
    },
    "/employees/{id}/salary": {
      "post": {
        "tags": [
          "Salary"
        ],
        "summary": "Add Salary Revision",
        "description": "Inserts a new immutable salary record and marks the previous active record as inactive — all within a single atomic transaction. Total CTC is calculated server-side.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalaryRevisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Salary revision created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalaryRevisionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      }
    },
    "/analytics": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Unified analytics endpoint",
        "description": "Returns all dashboard KPIs, distribution breakdowns, salary band frequencies, and the 5 most recent salary revisions in a single payload. All monetary values are in USD. Filters narrow all blocks (summary, distributions, bands, revisions) to the matching employee subset.",
        "parameters": [
          {
            "name": "departmentId",
            "in": "query",
            "description": "Filter by department UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "countryId",
            "in": "query",
            "description": "Filter by country UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by employee status",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unified analytics payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/export": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Export analytics to CSV",
        "description": "Generates a downloadable CSV of the filtered employee dataset. Accepts the same filter parameters as GET /analytics.",
        "parameters": [
          {
            "name": "departmentId",
            "in": "query",
            "description": "Filter by department UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "countryId",
            "in": "query",
            "description": "Filter by country UUID",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by employee status",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file download",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Department": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DepartmentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          }
        }
      },
      "Designation": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DesignationList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Designation"
            }
          }
        }
      },
      "Country": {
        "type": "object",
        "required": [
          "id",
          "name",
          "currencyCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "currencyCode": {
            "type": "string",
            "example": "INR"
          }
        }
      },
      "CountryList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Country"
            }
          }
        }
      },
      "CurrentSalary": {
        "type": "object",
        "properties": {
          "totalCtc": {
            "type": "number",
            "example": 1200000
          },
          "currencyCode": {
            "type": "string",
            "example": "INR"
          }
        }
      },
      "EmployeeListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string",
            "example": "EMP-00001"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "department": {
            "type": "string",
            "example": "Engineering"
          },
          "designation": {
            "type": "string",
            "example": "Software Engineer"
          },
          "country": {
            "type": "string",
            "example": "India"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "currentSalary": {
            "$ref": "#/components/schemas/CurrentSalary"
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 10000
          },
          "totalPages": {
            "type": "integer",
            "example": 500
          }
        }
      },
      "EmployeeList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeListItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "SalaryRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "totalCtc": {
            "type": "number"
          },
          "currencyCode": {
            "type": "string",
            "example": "INR"
          },
          "reason": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "EmployeeDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string",
            "example": "EMP-00001"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "department": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "designation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "country": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "currencyCode": {
                "type": "string",
                "example": "INR"
              }
            }
          },
          "salaryHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalaryRecord"
            }
          }
        }
      },
      "EmployeeCreateRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "departmentId",
          "designationId",
          "countryId",
          "joinDate",
          "initialSalary"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "designationId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "joinDate": {
            "type": "string",
            "format": "date"
          },
          "initialSalary": {
            "type": "object",
            "required": [
              "baseSalary",
              "bonus",
              "allowances",
              "effectiveDate",
              "reason"
            ],
            "properties": {
              "baseSalary": {
                "type": "number"
              },
              "bonus": {
                "type": "number"
              },
              "allowances": {
                "type": "number"
              },
              "effectiveDate": {
                "type": "string",
                "format": "date"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "EmployeeCreateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeCode": {
            "type": "string",
            "example": "EMP-00001"
          }
        }
      },
      "EmployeeUpdateRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "designationId": {
            "type": "string",
            "format": "uuid"
          },
          "countryId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "SalaryRevisionRequest": {
        "type": "object",
        "required": [
          "effectiveDate",
          "baseSalary",
          "bonus",
          "allowances",
          "reason"
        ],
        "properties": {
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "baseSalary": {
            "type": "number"
          },
          "bonus": {
            "type": "number"
          },
          "allowances": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SalaryRevisionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "totalCtc": {
            "type": "number"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "totalEmployees": {
            "type": "integer"
          },
          "activeEmployees": {
            "type": "integer"
          },
          "inactiveEmployees": {
            "type": "integer"
          },
          "totalPayrollUSD": {
            "type": "number",
            "format": "float"
          },
          "averageSalaryUSD": {
            "type": "number",
            "format": "float"
          },
          "medianSalaryUSD": {
            "type": "number",
            "format": "float",
            "description": "Median salary in USD. Calculated by sorting all active salary records and picking the middle value (or average of two middle values for even counts)."
          }
        }
      },
      "DepartmentAnalytics": {
        "type": "object",
        "properties": {
          "departmentName": {
            "type": "string",
            "example": "Engineering"
          },
          "headcount": {
            "type": "integer"
          },
          "averageSalaryUSD": {
            "type": "number"
          },
          "minSalaryUSD": {
            "type": "number"
          },
          "maxSalaryUSD": {
            "type": "number"
          },
          "totalPayrollUSD": {
            "type": "number"
          }
        }
      },
      "DesignationAnalytics": {
        "type": "object",
        "properties": {
          "designationName": {
            "type": "string",
            "example": "Software Engineer"
          },
          "headcount": {
            "type": "integer"
          },
          "averageSalaryUSD": {
            "type": "number"
          },
          "minSalaryUSD": {
            "type": "number"
          },
          "maxSalaryUSD": {
            "type": "number"
          }
        }
      },
      "CountryAnalytics": {
        "type": "object",
        "properties": {
          "countryName": {
            "type": "string",
            "example": "India"
          },
          "headcount": {
            "type": "integer"
          },
          "averageSalaryUSD": {
            "type": "number"
          },
          "totalPayrollUSD": {
            "type": "number"
          }
        }
      },
      "SalaryBand": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "example": "0-25k"
          },
          "employeeCount": {
            "type": "integer"
          }
        }
      },
      "RecentRevision": {
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string",
            "example": "EMP-00001"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "totalCtcUSD": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "AnalyticsResponse": {
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "departmentDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DepartmentAnalytics"
            }
          },
          "designationDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DesignationAnalytics"
            }
          },
          "countryDistribution": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryAnalytics"
            }
          },
          "salaryBands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalaryBand"
            }
          },
          "recentRevisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentRevision"
            }
          }
        }
      }
    }
  }
}